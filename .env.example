APP_NAME="National EduPortal Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ===================
# DATABASE CONFIGURATION
# ===================

# OPTION 1: SQLite (Default for Local - No setup required)
DB_CONNECTION=sqlite

# OPTION 2: MySQL (Uncomment and configure below)
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=national_eduportal
# DB_USERNAME=root
# DB_PASSWORD=

